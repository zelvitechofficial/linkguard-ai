# Database Configuration
# PostgreSQL connection string (Neon or any Postgres provider)
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname"

# Clerk Authentication
# Found in Clerk Dashboard > API Keys > Secret Key
CLERK_SECRET_KEY="sk_test_your_secret_key_here"

# RSA Public Key from Clerk Dashboard > API Keys
CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...YOUR_PUBLIC_KEY_HERE...
-----END PUBLIC KEY-----"

# Clerk JWKS Endpoint (for token validation)
CLERK_JWKS_URL="https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json"

# Clerk Webhook Signing Secret (Found in Webhooks > Endpoint > Signing Secret)
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# App Configuration
APP_NAME="LinkGuard AI"

# Authorized Administrator Email
ADMIN_EMAIL="admin@example.com"

# Google Gemini API Key (for the AI Chatbot)
GEMINI_API_KEY="your_gemini_api_key_here"

# CORS Configuration (Comma-separated list of allowed origins)
# In production, set this to your Netlify frontend URL
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
